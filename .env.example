# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Database (Neon Postgres) ----------
# Create a Neon project at https://neon.tech and copy the pooled connection string.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------- Auth.js ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-byte-base64-secret
AUTH_URL=http://localhost:3000

# Google OAuth (optional; leave blank to disable the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Seeding ----------
SEED_ADMIN_EMAIL=admin@pctrailers.test
SEED_ADMIN_PASSWORD=ChangeMe123!

# ---------- Stripe (Phase 2) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Vercel Blob (Phase 2) ----------
BLOB_READ_WRITE_TOKEN=

# ---------- Email: Resend (Phase 2) ----------
RESEND_API_KEY=
EMAIL_FROM="Pell City Trailer Rentals <bookings@pctrailers.test>"

# ---------- Optional SMS: Twilio (Phase 4) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
